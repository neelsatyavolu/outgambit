# Postgres connection string. For local development without a database,
# use pglite://.data/gambit (stored on disk) or pglite://memory.
DATABASE_URL=pglite://.data/gambit
# Password for /owner. At least 12 characters.
OWNER_PASSWORD=
# 32 random bytes, base64. Generate with: openssl rand -base64 32
SECRETS_KEY=
# At least 16 characters. Generate with: openssl rand -hex 16
IP_SALT=
# The site's public address. Password reset links are built on it.
# Required in production; elsewhere it defaults to http://localhost:3000.
# APP_URL=https://outgambit.n3el.dev
# Resend API key, for the password reset email. Required in production.
# Leave it out locally and the reset link is written to the server's console.
# RESEND_API_KEY=
